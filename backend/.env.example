# Copy this file to .env (or export these as real environment variables)
# before running the backend.

# Required for real AI extraction. Get a free key at
# https://aistudio.google.com/apikey (no credit card required).
# Without it, /ai/extract/* returns a clearly-labeled mock result instead
# of erroring out, so the rest of the app is still usable without a key.
GEMINI_API_KEY=

# Optional: override the extraction model (default: gemini-2.5-flash)
GEMINI_MODEL=

# Used to sign login tokens. Change this to a random string for anything
# beyond local development.
JWT_SECRET=dev-secret-change-me-in-production

# Defaults to a local SQLite file if unset. Point this at a real Postgres
# instance for anything beyond local development, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/ledger
DATABASE_URL=

# Where uploaded document files are stored on disk.
STORAGE_DIR=./storage
